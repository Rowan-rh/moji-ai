<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="moji_ai.db" />
        <exclude domain="database" path="moji_ai.db-shm" />
        <exclude domain="database" path="moji_ai.db-wal" />
        <exclude domain="file" path="bill_screenshots" />
        <exclude domain="sharedpref" path="moji_ai_config_prefs.xml" />
        <exclude domain="sharedpref" path="moji_webdav_prefs.xml" />
        <exclude domain="sharedpref" path="moji_app_update_prefs.xml" />
        <exclude domain="sharedpref" path="moji_app_lock_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="moji_ai_config_prefs.xml" />
        <exclude domain="sharedpref" path="moji_webdav_prefs.xml" />
        <exclude domain="sharedpref" path="moji_app_update_prefs.xml" />
        <exclude domain="sharedpref" path="moji_app_lock_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
