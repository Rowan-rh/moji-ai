<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 宣白暖石基底渐变（在纯白与深色壁纸上均有清晰温润边界） -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="18"
                android:endX="54"
                android:endY="90"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFF2EFE7" />
                <item android:offset="0.55" android:color="#FFEAE5DA" />
                <item android:offset="1.0" android:color="#FFDDD7C9" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 顶部柔和漫射柔光 -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="24"
                android:gradientRadius="50"
                android:type="radial">
                <item android:offset="0.0" android:color="#66FAF8F3" />
                <item android:offset="1.0" android:color="#00F2EFE7" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
