<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- QA 专属「晴空青蓝」高辨识度基底渐变（与正式包宣白暖石一眼区分） -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="18"
                android:endX="54"
                android:endY="90"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFE0F2FE" />
                <item android:offset="0.55" android:color="#FFBAE6FD" />
                <item android:offset="1.0" android:color="#FF7DD3FC" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 顶部柔和漫射柔光 -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="24"
                android:gradientRadius="50"
                android:type="radial">
                <item android:offset="0.0" android:color="#66F0F9FF" />
                <item android:offset="1.0" android:color="#00E0F2FE" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
