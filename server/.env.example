# 默记云同步后端配置示例（复制为 .env 后修改）
MOJI_BIND_ADDR=0.0.0.0:8787
# 裸机 / systemd 部署默认使用当前工作目录下的 ./data；docker-compose.yml 会自动覆盖为容器内 /data
MOJI_DATA_DIR=./data

# 必填：家庭/私有服务器密钥 SK（手机通过「URL + SK + 设备指纹」免密连接或换新机认领成员时强制校验；未配置时服务端将拒绝免密设备登录）
MOJI_SERVER_ACCESS_CODE=change-me-to-your-family-secret

# 可选：若在容器桥接网络后部署了可信反向代理（如 Caddy/Nginx 容器），设为 true 允许从代理读取 X-Real-IP
# MOJI_TRUST_PROXY_HEADERS=false

# 可选：自定义 32+ 位会话令牌签名密钥（留空时首次启动自动生成并保存在 MOJI_DATA_DIR/.token_secret）
# MOJI_TOKEN_SECRET=

# 每个专属密钥保留的历史快照回滚版本数量（默认 10，范围 1~50）
MOJI_MAX_HISTORY_REVISIONS=10

# 可选：限制允许注册的最大账本用户数（0 表示不限制，家庭自托管可设为如 10）
# MOJI_MAX_USERS=0

# 日志级别
RUST_LOG=moji_cloud_server=info,tower_http=info
