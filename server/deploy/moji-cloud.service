[Unit]
Description=MoJi Cloud Sync Server (Rust)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/moji-cloud
EnvironmentFile=/opt/moji-cloud/.env
ExecStart=/opt/moji-cloud/moji-cloud-server
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/moji-cloud/data

[Install]
WantedBy=multi-user.target
